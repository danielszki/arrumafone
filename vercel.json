{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/api-server run build",
  "buildCommand": "pnpm run typecheck:libs && PORT=4173 BASE_PATH=/ VITE_EVALUATION_API_URL=/api VITE_PUBLIC_SITE_URL=https://arrumafone.vercel.app pnpm --filter @workspace/arrumafone run build",
  "outputDirectory": "artifacts/arrumafone/dist/public",
  "rewrites": [
    {
      "source": "/avaliacao",
      "destination": "/avaliacao/index.html"
    },
    {
      "source": "/avaliacao/",
      "destination": "/avaliacao/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.arrumafone.vercel.app" }],
      "destination": "https://arrumafone.vercel.app/$1",
      "permanent": true
    }
  ]
}
